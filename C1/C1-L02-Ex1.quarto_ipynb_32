    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def l02q05(df):\n",
        "    p = {}\n",
        "    p['red n b'] = df.loc['b','red'].sum() / df.loc['b',].sum()\n",
        "    \n",
        "    print(f\"pr['red n b'] = {df.loc['b','red'].sum()} / {df.loc['b',].sum()} = {p['red n b']}\")        \n",
        "\n",
        "l02q05(mdf)"
      ],
