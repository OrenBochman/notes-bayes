        "def matmul(A, B):\n",
        "    return [[sum(A[i][k] * B[k][j] for k in range(len(B)))\n",
        "             for j in range(len(B[0]))]\n",
        "            for i in range(len(A))]\n",
        "\n",
        "def permute(A, P):\n",
        "    \"\"\"P is a permutation matrix; return PA.\"\"\"\n",
        "    return matmul(P, A)\n",
